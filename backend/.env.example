DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=network_telemetry
DB_USER=postgres
DB_PASSWORD=change-me
PORT=8007
SCAN_DEFAULT_SUBNET=auto
SCAN_ALLOWED_SUBNETS=auto
NMAP_PATH=nmap
NMAP_ENABLE_OS_DETECTION=true
NMAP_TOP_PORTS=100
NMAP_HOST_TIMEOUT_SECONDS=20
NMAP_PARALLEL_HOSTS=6
NMAP_EXPOSURE_CHECKS_ENABLED=true
NMAP_EXPOSURE_CHECK_TIMEOUT_SECONDS=25
NMAP_EXPOSURE_PARALLEL_HOSTS=4
SCAN_TIMEOUT_SECONDS=300
NVD_API_KEY=
NVD_CACHE_HOURS=24
NVD_MAX_RESULTS_PER_CPE=200
NVD_REQUEST_TIMEOUT_SECONDS=30
EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
EPSS_SCHEDULE_TIME=14:45
EPSS_TIMEZONE=Africa/Douala
EPSS_RETRY_MINUTES=10
EPSS_REQUEST_TIMEOUT_SECONDS=60
EPSS_MAX_DOWNLOAD_MB=50
# Layer 8: the network is flat, so there is no per-subnet exposure lookup. Every
# asset is scored with this single network-wide value. 65 is the spec 12.3
# "General staff/user network" figure.
NETWORK_EXPOSURE_VALUE=65
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NetBIOS name lookup (nbtstat -A). Off by default: it is local-broadcast only,
# and on Windows a 2s lookup cannot be reaped until ~9s, which added ~6s to a
# scan on a 7-host /24 while resolving no additional hostnames. Enable it only
# on networks with legacy Windows hosts that genuinely need it.
NETBIOS_NAME_RESOLUTION_ENABLED=false
NETBIOS_TIMEOUT_SECONDS=2
